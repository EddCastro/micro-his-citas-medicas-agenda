@startuml
title DESPUES - Regla en el dominio, datos y concurrencia tras contratos separados

skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam classAttributeIconSize 0
hide empty members

package Application {
  class RequestAppointment {
    +execute(RequestAppointmentInput): AppointmentOutput
  }
  class QueryAvailability {
    +execute(doctorId, date, duration): TimeSlot[]
  }
}

package Domain {
  class TimeSlot <<value object>> {
    +start: DateTimeImmutable
    +end: DateTimeImmutable
    +overlaps(TimeSlot): bool
    +within(TimeSlot): bool
  }
  class SlotPolicy <<domain service>> {
    +assertBookable(shifts, busy, requested): void
    +freeSlots(shifts, busy, duration): TimeSlot[]
  }
  class OutsideWorkingHours <<exception>>
  class SlotTaken <<exception>>
  interface DoctorScheduleProvider {
    +shiftsOf(doctorId, date): TimeSlot[]
  }
  interface AgendaReader {
    +busySlotsOf(doctorId, date): TimeSlot[]
  }
  interface TransactionRunner {
    +run(callable): mixed
  }
  interface AgendaLock {
    +lockDoctorDay(doctorId, date): void
  }
  interface AppointmentRepository {
    +save(Appointment): int
  }
}

package Persistence {
  class LocalScheduleProvider
  class EloquentAgendaReader
  class DbTransactionRunner
}

RequestAppointment --> SlotPolicy
QueryAvailability --> SlotPolicy
SlotPolicy --> TimeSlot
SlotPolicy ..> OutsideWorkingHours : lanza
SlotPolicy ..> SlotTaken : lanza
RequestAppointment ..> TransactionRunner
RequestAppointment ..> AgendaLock
RequestAppointment ..> DoctorScheduleProvider
RequestAppointment ..> AgendaReader
RequestAppointment ..> AppointmentRepository
QueryAvailability ..> DoctorScheduleProvider
QueryAvailability ..> AgendaReader

LocalScheduleProvider ..|> DoctorScheduleProvider
EloquentAgendaReader ..|> AgendaReader
DbTransactionRunner ..|> TransactionRunner
DbTransactionRunner ..|> AgendaLock

note bottom of RequestAppointment
run( lockDoctorDay -> shiftsOf -> busySlotsOf
     -> assertBookable -> save )
La atomicidad es explicita en el caso de uso.
end note

@enduml
